# ==========================================================================
# Caddyfile — AmazeBase landing page
#
# Overrides Railpack's built-in static-site config so we can send stricter
# security headers. Based on Railpack's own template (railpack/core/providers/
# staticfile/Caddyfile.template) — the serving behaviour below is unchanged;
# only the header block is tightened.
#
# If this file is deleted, Railway falls back to the Railpack default and the
# site still serves — it just loses the hardened headers.
# ==========================================================================
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		# --- Clickjacking -------------------------------------------------
		# Nobody may embed this page in a frame. Without this, an attacker can
		# iframe the site and overlay an invisible form on top of the real
		# waitlist form. frame-ancestors is the modern rule; X-Frame-Options
		# is the same instruction for older browsers.
		X-Frame-Options "DENY"

		# --- Force HTTPS for a year, including future subdomains ----------
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# --- Don't let a browser guess a file's type ----------------------
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"

		# --- Don't leak the full URL to other sites -----------------------
		Referrer-Policy "strict-origin-when-cross-origin"

		# --- Turn off device APIs this site never uses --------------------
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()"

		# --- Content Security Policy --------------------------------------
		# Deliberately strict. The whole site has ZERO inline <script> blocks
		# and ZERO inline event handlers, so script-src is locked to 'self':
		# even if someone found a way to inject a <script> tag, the browser
		# would refuse to run it.
		#
		#   script-src  'self' + ONE sha256 hash. The pipeline section ships as
		#               a self-contained block with an inline <script>; hashing
		#               that exact script keeps the policy strict -- any OTHER
		#               inline script, including an injected one, is still
		#               refused. If that block's script is ever edited by so
		#               much as a byte the hash stops matching and the section
		#               goes static: recompute with
		#                 python -c "import hashlib,base64,sys;print(base64.b64encode(hashlib.sha256(open(sys.argv[1],'rb').read()).digest()).decode())" script.txt
		#               where script.txt is the text BETWEEN the script tags.
		#               Plus www.googletagmanager.com for Google Analytics 4:
		#               gtag.js comes from there, and its init lines live in
		#               /js/analytics.js (allowed by 'self') precisely so they
		#               need no second hash. googleadservices.com and
		#               googleads.g.doubleclick.net are the Google Ads
		#               conversion, which js/waitlist.js fires on a signup.
		#   img-src / connect-src also name Google Analytics' collection
		#               origins, and the Ads ones for the same reason -- a
		#               conversion is often recorded as an image request.
		#               Without them the tag loads and every beacon is
		#               refused, which shows in the console and nowhere else.
		#               tools/analytics.py --check asserts all of these origins.
		#               pagead2.googlesyndication.com is the Ads tag's ccm/collect
		#               call, which it makes on every page load -- it was missed
		#               in the first version of this policy and added 2026-09-12
		#               after watching the live site.
		#               Ads also pings country domains (www.google.com.mx and
		#               the like) that no wildcard can express; only
		#               www.google.com is listed, so expect a console warning
		#               for those. The conversion itself goes to
		#               googleadservices.com and is not affected.
		#               www.clarity.ms is Microsoft Clarity, and *.clarity.ms
		#               plus c.bing.com are where it sends recordings. It is
		#               loaded by js/consent.js and ONLY for a visitor who
		#               accepted analytics, so these origins are contacted on
		#               no other page view.
		#   frame-src   Ads writes a hidden iframe to doubleclick to join a
		#               click to a conversion. default-src 'self' would
		#               otherwise refuse it and the conversion would be
		#               attributed to nobody. This is NOT frame-ancestors,
		#               which still refuses everyone below.
		#   style-src   needs 'unsafe-inline' — 18 inline style="" attributes
		#               remain in the HTML. Inline STYLES cannot execute code,
		#               so this is a formatting concession, not a script hole.
		#               Removing those attributes would let us drop it.
		#   connect-src -> only the app that owns the waitlist table. This has to
#               name the SAME host js/waitlist.js and js/hub.js fetch, or
#               the browser refuses the request before it is sent: the
#               form reports "Failed to fetch" and nothing whatsoever
#               reaches the server, so the app's logs stay empty and its
#               ALLOWED_ORIGINS is never even consulted. Change one, change
#               the other.
		#   frame-ancestors 'none' -> the clickjacking rule above
		#   object-src 'none' -> no Flash/Java/embed legacy plugins
		#   base-uri 'self' -> an injected <base> tag can't redirect our URLs
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-C3Lmc3qMncd1P492JzpHzLfTKaMxj+oxEm1lWKQnQng=' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://pagead2.googlesyndication.com; media-src 'self'; connect-src 'self' https://analytics.amazebase.pro https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://pagead2.googlesyndication.com https://*.clarity.ms https://c.bing.com; frame-src https://td.doubleclick.net https://googleads.g.doubleclick.net; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"

		# Don't advertise the server software.
		-Server
	}

	root * {$RAILPACK_STATIC_FILE_ROOT:.}

	file_server {
		hide .git
		hide .env*
		# build scripts, not part of the published site
		hide tools
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
