"/><path d=\"M12,9h4l3,3v3h-7Z\"/><circle cx=\"6\" cy=\"16.6\" r=\"1.7\"/><circle cx=\"15.4\" cy=\"16.6\" r=\"1.7\"/></g><text x=\"494\" y=\"101\">Fornecedor</text></g>\n      <g class=\"abc-node\" style=\"--c:#8B5CF6\"><rect class=\"abc-tile\" x=\"444\" y=\"119\" width=\"34\" height=\"34\" rx=\"10\"/><g class=\"abc-gi\" transform=\"translate(450,125)\"><path d=\"M5,3h8l4,4v12H5Z\"/><path d=\"M13,3v4h4\"/><path d=\"M8,12h6M8,15h4\"/></g><text x=\"486\" y=\"141\">Relat&oacute;rios</text></g>\n      <g class=\"abc-node\" style=\"--c:#A855F7\"><rect class=\"abc-tile\" x=\"226\" y=\"158\" width=\"34\" height=\"34\" rx=\"10\"/><g class=\"abc-gi\" transform=\"translate(232,164)\"><path d=\"M11,3.6 12.8,9.2 18.4,11 12.8,12.8 11,18.4 9.2,12.8 3.6,11 9.2,9.2Z\"/></g><text x=\"268\" y=\"180\">Assistente de IA</text></g>\n          </svg>\n        </div>\n        <span class=\"abc-verdict abc-verdict--good\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"\n               stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8 12l3 3 5-6\"/></svg>\n          Conectado. Automatizado. Inteligente.\n        </span>\n      </div>\n\n    </div>\n    <span class=\"abc-vs\">VS</span>\n  </div>\n</section>\n<!-- ================= end AmazeBase compare section ================= -->\n\n\n<!-- ====================================================================\n     FEATURES\n==================================================================== -->\n<section class=\"section\" id=\"features\">\n<div class=\"container\">\n\n  <div class=\"section-head\" data-reveal>\n    <span class=\"eyebrow\">Funcionalidades</span>\n    <h2>Tudo o que voc&ecirc; precisa para crescer com lucro</h2>\n    <p>Seis sistemas conectados que substituem as planilhas, as abas e os palpites que voc&ecirc; usa hoje.</p>\n  </div>\n\n  <div class=\"feature-grid\" data-reveal-stagger>\n\n    <article class=\"feature\">\n      <div class=\"feature-thumb\">\n        <img src=\"assets/img/feat-discover.png\" alt=\"Lupa sobre um gr&aacute;fico de tend&ecirc;ncia em alta\" width=\"768\" height=\"264\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <h3>Descubra oportunidades</h3>\n      <p>Encontre produtos e palavras-chave vencedores antes dos seus concorrentes, com dados reais de demanda.</p>\n      <a class=\"feature-link\" href=\"product.html#research\">Saiba mais <svg><use href=\"#i-arrow\"/></svg></a>\n    </article>\n\n    <article class=\"feature\">\n      <div class=\"feature-thumb\">\n        <img src=\"assets/img/feat-decisions.png\" alt=\"Painel de an&aacute;lise mostrando faturamento e vendas por canal\" width=\"768\" height=\"264\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <h3>Tome decis&otilde;es melhores</h3>\n      <p>An&aacute;lises em tempo real que mostram o que est&aacute; funcionando e o que est&aacute;, em sil&ecirc;ncio, fazendo voc&ecirc; perder dinheiro.</p>\n      <a class=\"feature-link\" href=\"product.html#advertising\">Saiba mais <svg><use href=\"#i-arrow\"/></svg></a>\n    </article>\n\n    <article class=\"feature\">\n      <div class=\"feature-thumb\">\n        <img src=\"assets/img/feat-stock.png\" alt=\"Caixas de envio empilhadas com indicadores de reposi&ccedil;&atilde;o\" width=\"768\" height=\"264\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <h3>Nunca fique sem estoque</h3>\n      <p>Saiba qual &eacute; o &uacute;ltimo dia seguro para repor, e quantas unidades, antes que uma ruptura de estoque custe o seu ranqueamento.</p>\n      <a class=\"feature-link\" href=\"product.html#inventory\">Saiba mais <svg><use href=\"#i-arrow\"/></svg></a>\n    </article>\n\n    <article class=\"feature\">\n      <div class=\"feature-thumb\">\n        <img src=\"assets/img/feat-profit.png\" alt=\"Gr&aacute;fico de barras que detalha o lucro\" width=\"768\" height=\"264\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <h3>Entenda o seu lucro</h3>\n      <p>An&aacute;lise do lucro de verdade, depois de taxas, an&uacute;ncios, reembolsos, armazenagem e todos os outros custos reais.</p>\n      <a class=\"feature-link\" href=\"product.html#financials\">Saiba mais <svg><use href=\"#i-arrow\"/></svg></a>\n    </article>\n\n    <article class=\"feature\">\n      <div class=\"feature-thumb\">\n        <img src=\"assets/img/feat-forecast.png\" alt=\"Gr&aacute;fico de linha prevendo uma tend&ecirc;ncia de alta\" width=\"768\" height=\"264\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <h3>Planeje com meses de anteced&ecirc;ncia</h3>\n      <p>Preveja o fluxo de caixa, as necessidades de estoque e o crescimento com confian&ccedil;a, e n&atilde;o com esperan&ccedil;a.</p>\n      <a class=\"feature-link\" href=\"product.html#simulations\">Saiba mais <svg><use href=\"#i-arrow\"/></svg></a>\n    </article>\n\n    <article class=\"feature\">\n      <div class=\"feature-thumb\">\n        <img src=\"assets/img/feat-ai.png\" alt=\"Bal&otilde;es de conversa representando um assistente de IA\" width=\"768\" height=\"264\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <h3>IA que conhece o seu neg&oacute;cio</h3>\n      <p>Pergunte qualquer coisa e receba respostas pr&aacute;ticas a partir dos seus pr&oacute;prios dados conectados.</p>\n      <a class=\"feature-link\" href=\"product.html#assistant\">Saiba mais <svg><use href=\"#i-arrow\"/></svg></a>\n    </article>\n\n  </div>\n</div>\n</section>\n\n<!-- ====================================================================\n     AI ASSISTANT\n==================================================================== -->\n<section class=\"section\" id=\"assistant\">\n<div class=\"container\">\n<div class=\"assistant-panel\" data-reveal>\n\n  <div class=\"assistant-copy\">\n    <span class=\"eyebrow\">Assistente de IA</span>\n    <h2>Pare de ler relat&oacute;rios.<br>Comece a fazer perguntas.</h2>\n    <p>Fa&ccedil;a uma pergunta e receba uma resposta constru&iacute;da a partir dos seus pr&oacute;prios\n       dados conectados, com os n&uacute;meros por tr&aacute;s dela.</p>\n    <a class=\"btn btn--primary btn--lg\" href=\"#waitlist\" data-waitlist-open data-source=\"assistant\" data-magnetic>\n      Entre na lista de espera <svg class=\"icon-sm\"><use href=\"#i-arrow\"/></svg>\n    </a>\n  </div>\n\n  <div class=\"chat\">\n\n    <div class=\"chat-row is-user\">\n      <div class=\"bubble is-user\">Quanto estoque devo pedir do Moedor de Caf&eacute; Port&aacute;til para o pr&oacute;ximo m&ecirc;s?</div>\n      <span class=\"chat-avatar is-user has-photo\"><img src=\"assets/img/avatar-mj.webp\" alt=\"\" width=\"34\" height=\"34\" loading=\"lazy\" decoding=\"async\"></span>\n    </div>\n\n    <div class=\"chat-row\">\n      <span class=\"chat-avatar is-ai\"><svg class=\"icon-sm\"><use href=\"#i-spark\"/></svg></span>\n      <div class=\"bubble is-ai\">\n        <strong>Recomendo pedir 640 unidades.</strong>\n        <p style=\"margin-top:6px;color:var(--text-2)\">Isso cobre a demanda por 36 dias, evita rupturas de estoque e mant&eacute;m o fluxo de caixa saud&aacute;vel.</p>\n\n        <div class=\"chat-metrics\">\n          <div class=\"chat-metric\"><span>Previs&atilde;o de demanda</span><b>620 unidades</b></div>\n          <div class=\"chat-metric\"><span>Dias de cobertura</span><b>36 dias</b></div>\n          <div class=\"chat-metric\"><span>Lucro estimado</span><b class=\"is-green\">$4,820</b></div>\n          <div class=\"chat-metric\"><span>Impacto no caixa</span><b class=\"is-red\">−$2,950</b></div>\n        </div>\n\n        <p class=\"chat-foot\">Exemplo ilustrativo &mdash; o Assistente de IA ainda n&atilde;o est&aacute; dispon&iacute;vel.</p>\n      </div>\n    </div>\n\n  </div>\n\n</div>\n</div>\n</section>\n\n<!-- ====================================================================\n     PROOF\n==================================================================== -->\n<section class=\"section\">\n<div class=\"container\">\n<div class=\"proof-grid\" data-reveal>\n\n  <div class=\"trust\">\n    <p class=\"trust-lead\">Feito para vendedores da Amazon que levam o neg&oacute;cio a s&eacute;rio</p>\n\n    <!-- Figures describe what the product does, not how many people use it:\n         each one is stated on product.html and can be checked against it.\n         Small integers, so no data-counter — counting 0 to 8 reads worse\n         than simply showing 8. -->\n    <div class=\"trust-stat\">\n      <span class=\"icon-tile is-art\"><img src=\"assets/img/stat-connection.webp\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\" decoding=\"async\"></span>\n      <div><b>8</b><span>M&oacute;dulos conectados</span></div>\n    </div>\n    <div class=\"trust-stat\">\n      <span class=\"icon-tile is-art\"><img src=\"assets/img/stat-reports.webp\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\" decoding=\"async\"></span>\n      <div><b>10</b><span>Tipos de relat&oacute;rio da Amazon</span></div>\n    </div>\n    <div class=\"trust-stat\">\n      <span class=\"icon-tile is-art\"><img src=\"assets/img/stat-sales.webp\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\" decoding=\"async\"></span>\n      <div><b>7</b><span>Vereditos de PPC</span></div>\n    </div>\n    <div class=\"trust-stat\">\n      <span class=\"icon-tile is-art\"><img src=\"assets/img/stat-products.webp\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\" decoding=\"async\"></span>\n      <div><b>4</b><span>Dimens&otilde;es de oportunidade</span></div>\n    </div>\n  </div>\n\n  <figure class=\"quote\">\n    <span class=\"quote-face\" aria-hidden=\"true\">LS</span>\n    <div>\n      <p>&ldquo;Seis ferramentas, e nenhuma delas me dizia o que fazer em seguida. Ent&atilde;o constru&iacute; a que\n         diz. Ela substituiu as seis e me poupa mais de 30 horas por m&ecirc;s.&rdquo;</p>\n      <cite>— Leon Silva, vendedor da Amazon com faturamento de 6 d&iacute;gitos</cite>\n    </div>\n  </figure>\n\n</div>\n</div>\n</section>\n\n<!-- ====================================================================\n     PRICING\n==================================================================== -->\n<section class=\"section\" id=\"pricing\">\n<div class=\"container\">\n<div class=\"pricing-grid\" data-reveal>\n\n  <div class=\"price-lead\">\n    <span class=\"eyebrow\">Pre&ccedil;os</span>\n    <h2>Entre na lista de espera hoje.</h2>\n    <p>Pre&ccedil;o simples. Valor enorme.</p>\n    <ul class=\"ticks\">\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Acesso antecipado no lan&ccedil;amento</li>\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Acesso completo a todos os recursos</li>\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Sem dados de pagamento</li>\n    </ul>\n  </div>\n\n  <div class=\"price-card is-featured\">\n    <span class=\"price-badge\">Mais popular</span>\n    <span class=\"price-name\">Plano Pro</span>\n    <div class=\"price-fig\"><b>$159</b><span>/m&ecirc;s</span></div>\n    <p class=\"price-note\">Tudo o que voc&ecirc; precisa para fazer o seu neg&oacute;cio na Amazon crescer.</p>\n    <ul class=\"price-list\">\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Produtos e relat&oacute;rios ilimitados</li>\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>An&aacute;lise de publicidade e lucro</li>\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Previs&atilde;o de estoque e fluxo de caixa</li>\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Acompanhamento de fornecedores e pedidos de compra</li>\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Assistente de IA quando for lan&ccedil;ado</li>\n    </ul>\n    <a class=\"btn btn--primary btn--lg btn--block\" href=\"#waitlist\" data-waitlist-open data-source=\"pricing-pro\" data-magnetic>Entre na lista de espera</a>\n  </div>\n\n  <div class=\"price-card\">\n    <span class=\"price-name\">Enterprise</span>\n    <div class=\"price-fig\"><b>Sob consulta</b></div>\n    <p class=\"price-note\">Para vendedores de alto volume e equipes com necessidades avan&ccedil;adas.</p>\n    <ul class=\"price-list\">\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Tudo do Pro</li>\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>V&aacute;rios marketplaces e v&aacute;rias contas</li>\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Usu&aacute;rios da equipe e permiss&otilde;es</li>\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Acesso &agrave; API</li>\n      <li><svg class=\"icon-sm\"><use href=\"#i-check\"/></svg>Implanta&ccedil;&atilde;o dedicada</li>\n    </ul>\n    <a class=\"btn btn--ghost btn--lg btn--block\" href=\"#waitlist\" data-waitlist-open data-source=\"pricing-enterprise\">Fale com vendas</a>\n  </div>\n\n</div>\n</div>\n</section>\n\n</main>",
