o\"><path d=\"M0,1.5 L10,5 L0,8.5Z\" fill=\"#A959C4\"/></marker>\n              <marker id=\"abcA_ai\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto\"><path d=\"M0,1.5 L10,5 L0,8.5Z\" fill=\"#C079E0\"/></marker>\n            </defs>\n\n            <!-- connectors leave a hub EDGE and terminate on their tile -->\n            <path class=\"abc-link\" d=\"M211,76 C186,76 168,58 138,56\" stroke=\"#6FAEDC\" style=\"filter:drop-shadow(0 0 3px #6FAEDC)\" marker-end=\"url(#abcA_prod)\"/>\n            <path class=\"abc-link\" d=\"M211,96 L136,96\" stroke=\"#BE79FE\" style=\"filter:drop-shadow(0 0 3px #BE79FE)\" marker-end=\"url(#abcA_inv)\"/>\n            <path class=\"abc-link\" d=\"M211,116 C186,116 168,138 138,138\" stroke=\"#9ABFD9\" style=\"filter:drop-shadow(0 0 3px #9ABFD9)\" marker-end=\"url(#abcA_adv)\"/>\n            <path class=\"abc-link\" d=\"M349,76 C374,76 404,58 434,56\" stroke=\"#678EDB\" style=\"filter:drop-shadow(0 0 3px #678EDB)\" marker-end=\"url(#abcA_fin)\"/>\n            <path class=\"abc-link\" d=\"M349,96 L442,96\" stroke=\"#9A55C8\" style=\"filter:drop-shadow(0 0 3px #9A55C8)\" marker-end=\"url(#abcA_sup)\"/>\n            <path class=\"abc-link\" d=\"M349,116 C374,116 404,138 434,138\" stroke=\"#A959C4\" style=\"filter:drop-shadow(0 0 3px #A959C4)\" marker-end=\"url(#abcA_rep)\"/>\n            <path class=\"abc-link\" d=\"M280,142 L280,154\" stroke=\"#C079E0\" style=\"filter:drop-shadow(0 0 3px #C079E0)\" marker-end=\"url(#abcA_ai)\"/>\n\n            <!-- hub: RECTANGULAR, 138x92 = 1.50. Measured off the reference at 7x\n                 zoom: 128x86 = 1.49. An earlier pass called it square and built it\n                 104x104, which was wrong in both directions. The mark is a stroked\n                 rounded arch with a violet-to-magenta grade, not a filled triangle. -->\n            <rect x=\"211\" y=\"50\" width=\"138\" height=\"92\" rx=\"16\"\n                  fill=\"#7C5CF0\" opacity=\".16\"